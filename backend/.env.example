# Copy to backend/.env and adjust.
DEMO_MODE=true
LOG_LEVEL=INFO

# Live forecast sources (free, no key needed)
GFS_ENABLED=true
ECMWF_ENABLED=true
AIFS_ENABLED=true

# Independent verification against ERA5 (free Copernicus CDS key: https://cds.climate.copernicus.eu)
ERA5_ENABLED=false
# ERA5_CDS_KEY=your-cds-api-key
